<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="24dp"
        android:baselineAligned="false">

        <!-- Left: title and status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/missionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Autonomous Mission"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/missionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Status: Idle"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/missionProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Progress: 0%"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/missionZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Zone: Not Selected"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/missionWaypoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Waypoint: 0 / 0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detectionCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Detections: 0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/missionTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mission Time: 00:00"
                android:textSize="16sp" />


            <Spinner
                android:id="@+id/zoneSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />



        </LinearLayout>

        <!-- Right: controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startMission"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Start Mission" />

                <Button
                    android:id="@+id/pauseMission"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Pause Mission" />
            </LinearLayout>

            <Button
                android:id="@+id/stopMission"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#C62828"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Stop Mission" />
            <Button
                android:id="@+id/backToController"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="Back" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>