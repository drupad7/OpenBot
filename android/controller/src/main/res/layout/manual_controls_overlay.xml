<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Left / right drive values (what the sliders are commanding) -->
    <LinearLayout
        android:id="@+id/manualValuesPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shaded"
        android:gravity="center_horizontal"
        android:minWidth="180dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual Control"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/manualLeftValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Left   +0.00"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/manualRightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Right  +0.00"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Shown only while a route is being recorded -->
        <LinearLayout
            android:id="@+id/routePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/routeTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recording route"
                android:textColor="#FF5252"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/routeGpsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS: waiting for fix"
                android:textColor="#FFB74D"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/routeWaypointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waypoints: 0"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/routeFinishButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finish route" />

                <Button
                    android:id="@+id/routeCancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Cancel route" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Back to the main controller menu (placed clear of the left slider) -->
    <Button
        android:id="@+id/manualBackButton"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="160dp"
        android:layout_marginBottom="20dp"
        android:minWidth="110dp"
        android:text="Back" />

</FrameLayout>